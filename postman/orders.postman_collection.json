{
  "info": {
    "name": "Orders API — Лабораторна робота № 5",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3005",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login (Bob)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('статус 200', () => pm.response.to.have.status(200));",
              "pm.test('наявність токена доступу', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.accessToken).to.be.a('string');",
              "  pm.collectionVariables.set('token', body.accessToken);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"bob@example.com\",\n  \"password\": \"Secret123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "2. Create Order",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('статус 201', () => pm.response.to.have.status(201));",
              "pm.test('сума з доставкою', () => {",
              "  pm.expect(pm.response.json().total).to.eql(560);",
              "});",
              "pm.test('наявність Location заголовка', () => {",
              "  pm.response.to.have.header('Location');",
              "});",
              "pm.collectionVariables.set('orderId', pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"sku\": \"SKU-A\",\n      \"price\": 500,\n      \"qty\": 1\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": ["{{baseUrl}}"],
          "path": ["orders"]
        }
      }
    },
    {
      "name": "3. Get Order",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('статус 200', () => pm.response.to.have.status(200));",
              "pm.test('збіг id замовлення', () => {",
              "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('orderId'));",
              "});",
              "pm.test('коректність структури замовлення', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.tier).to.eql('basic');",
              "  pm.expect(body.total).to.eql(560);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders/{{orderId}}",
          "host": ["{{baseUrl}}"],
          "path": ["orders", "{{orderId}}"]
        }
      }
    }
  ]
}
