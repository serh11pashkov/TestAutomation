{
  "name": "qa-automation-lab5-rest-api",
  "version": "1.0.0",
  "description": "Lab 5: REST API Test Automation with Supertest, JSON Schema, and Newman (Variant 8)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:newman": "newman run postman/orders.postman_collection.json",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "rest-api",
    "supertest",
    "json-schema",
    "ajv",
    "newman",
    "postman",
    "vitest"
  ],
  "author": "Serhii Pashkov",
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.4",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.12.0",
    "newman": "^6.2.1",
    "prettier": "^3.9.9",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
